@page
@model FantasyBooks.Pages.Admin.LoginModel
@{
    ViewData["Title"] = "Admin sign in";
}

<div class="mx-auto max-w-md space-y-8 pb-8">
    <header class="rounded-2xl border border-ink/10 bg-white/35 px-6 py-8 text-center shadow-float backdrop-blur-[10px]">
        <p class="text-xs font-semibold uppercase tracking-[0.35em] text-ink/45">Bookish Ink &amp; Paper</p>
        <h1 class="mt-2 font-display text-3xl font-semibold tracking-tight text-ink">Admin sign in</h1>
        <p class="mt-3 text-sm text-ink/60">Sign in to manage the ledger and catalog.</p>
    </header>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="rounded-2xl border border-red-300/50 bg-red-50/50 px-5 py-4 text-sm text-red-950" role="alert">
            @Model.ErrorMessage
        </div>
    }

    <form method="post" class="space-y-5 rounded-2xl border border-ink/10 bg-white/35 p-6 shadow-float backdrop-blur-[10px] sm:p-8">
        <div>
            <label asp-for="Input.Username" class="mb-2 block text-xs font-semibold uppercase tracking-widest text-gold-600"></label>
            <input asp-for="Input.Username" autocomplete="username"
                   class="w-full rounded-xl border border-ink/15 bg-white/60 px-4 py-3 text-sm text-ink outline-none ring-gold-500/30 focus:ring-2" />
            <span asp-validation-for="Input.Username" class="mt-1 block text-xs text-red-700"></span>
        </div>
        <div>
            <label asp-for="Input.Password" class="mb-2 block text-xs font-semibold uppercase tracking-widest text-gold-600"></label>
            <input asp-for="Input.Password" autocomplete="current-password"
                   class="w-full rounded-xl border border-ink/15 bg-white/60 px-4 py-3 text-sm text-ink outline-none ring-gold-500/30 focus:ring-2" />
            <span asp-validation-for="Input.Password" class="mt-1 block text-xs text-red-700"></span>
        </div>
        <label class="flex items-center gap-2 text-sm text-ink/70">
            <input asp-for="Input.RememberMe" class="rounded border-ink/20" />
            <span>Remember me</span>
        </label>
        <button type="submit" class="magical-glow-btn w-full rounded-xl bg-gold-500 px-7 py-3 text-sm font-semibold text-ink shadow-md transition hover:bg-gold-600">
            Sign in
        </button>
    </form>
</div>
