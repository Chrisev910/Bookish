@page "{id:int}"
@model FantasyBooks.Pages.Admin.Products.EditModel
@{
    ViewData["Title"] = "Edit product";
    ViewData.TemplateInfo.HtmlFieldPrefix = "Input";
    ViewData["EditProductId"] = Model.Id;
}

<div class="mx-auto max-w-xl space-y-8 pb-8">
    <header class="rounded-2xl border border-ink/10 bg-white/35 px-6 py-8 text-center shadow-float backdrop-blur-[10px]">
        <h1 class="font-display text-3xl font-semibold text-ink">Edit product</h1>
        <div class="mt-6">
            <partial name="../_AdminNav" />
        </div>
    </header>

    <partial name="_ProductForm" model="Model.Input" />

    @if (ViewData["GalleryThumbs"] is IReadOnlyList<(int Id, string Src)> thumbs && thumbs.Count > 0)
    {
        <section class="rounded-2xl border border-ink/10 bg-white/35 p-6 shadow-float backdrop-blur-[10px] sm:p-8" aria-label="Gallery images">
            <h2 class="text-xs font-semibold uppercase tracking-widest text-gold-600">Current gallery images</h2>
            <p class="mt-1 text-xs text-ink/45">These appear after the cover on the product page carousel.</p>
            <ul class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3">
                @foreach (var thumb in thumbs)
                {
                    <li class="overflow-hidden rounded-xl ring-1 ring-ink/10">
                        <img src="@thumb.Src" alt="" class="aspect-square w-full object-cover" />
                        <form method="post" asp-page-handler="DeleteGallery" class="border-t border-ink/10 bg-white/50 px-2 py-1.5 text-center">
                            <input type="hidden" name="Id" value="@Model.Id" />
                            <input type="hidden" name="galleryImageId" value="@thumb.Id" />
                            <button type="submit" class="text-xs font-semibold text-ink/55 transition hover:text-red-700">Remove</button>
                        </form>
                    </li>
                }
            </ul>
        </section>
    }
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
    <script src="~/js/admin-quill.js" asp-append-version="true"></script>
    <script src="~/js/admin-product-options.js" asp-append-version="true"></script>
}
