@model FantasyBooks.Pages.Admin.Products.CreateModel.ProductInput

<form method="post" enctype="multipart/form-data" class="space-y-5 rounded-2xl border border-ink/10 bg-white/35 p-6 shadow-float backdrop-blur-[10px] sm:p-8" id="product-form">
    @if (ViewData["EditProductId"] is int editId)
    {
        <input type="hidden" name="Id" value="@editId" />
    }
    <div>
        <label asp-for="Name" class="mb-2 block text-xs font-semibold uppercase tracking-widest text-gold-600"></label>
        <input asp-for="Name" class="w-full rounded-xl border border-ink/15 bg-white/60 px-4 py-3 text-sm text-ink outline-none focus:ring-2 focus:ring-gold-500/30" />
        <span asp-validation-for="Name" class="mt-1 block text-xs text-red-700"></span>
    </div>
    <div>
        <label asp-for="Price" class="mb-2 block text-xs font-semibold uppercase tracking-widest text-gold-600"></label>
        <input asp-for="Price" type="number" step="0.01" min="0.01"
               class="w-full rounded-xl border border-ink/15 bg-white/60 px-4 py-3 text-sm text-ink outline-none focus:ring-2 focus:ring-gold-500/30" />
        <span asp-validation-for="Price" class="mt-1 block text-xs text-red-700"></span>
    </div>
    <div>
        <label class="mb-2 block text-xs font-semibold uppercase tracking-widest text-gold-600">Cover image</label>
        <input type="file" name="ImageFile" accept="image/jpeg,image/png,image/webp,image/gif,.jpg,.jpeg,.png,.webp,.gif"
               class="block w-full cursor-pointer text-sm text-ink file:mr-4 file:cursor-pointer file:rounded-xl file:border file:border-gold-500/50 file:bg-gold-500/10 file:px-5 file:py-2.5 file:text-sm file:font-semibold file:text-gold-600" />
        @if (ViewContext.ModelState["ImageFile"]?.Errors is { Count: > 0 } fileErrors)
        {
            <span class="mt-1 block text-xs text-red-700">@fileErrors[0].ErrorMessage</span>
        }
        <p class="mt-1 text-xs text-ink/45">Upload JPEG, PNG, WebP, or GIF (max 2&nbsp;MB). Stored in your Turso/SQLite database so it survives redeploys.</p>
        @if (ViewData["CurrentImageSrc"] is string currentSrc && !string.IsNullOrWhiteSpace(currentSrc))
        {
            <img src="@currentSrc" alt="" class="mt-3 max-h-40 rounded-xl object-cover ring-1 ring-ink/10" />
            <label class="mt-2 flex items-center gap-2 text-xs text-ink/60">
                <input type="checkbox" name="RemoveUploadedImage" value="true" class="rounded border-ink/20" />
                Remove uploaded image
            </label>
        }
    </div>
    <div>
        <label asp-for="ImageUrl" class="mb-2 block text-xs font-semibold uppercase tracking-widest text-gold-600"></label>
        <input asp-for="ImageUrl" placeholder="https://…"
               class="w-full rounded-xl border border-ink/15 bg-white/60 px-4 py-3 text-sm text-ink outline-none focus:ring-2 focus:ring-gold-500/30" />
        <span asp-validation-for="ImageUrl" class="mt-1 block text-xs text-red-700"></span>
        <p class="mt-1 text-xs text-ink/45">Optional fallback if you prefer a link instead of uploading (e.g. TikTok CDN).</p>
    </div>
    <div>
        <label class="mb-2 block text-xs font-semibold uppercase tracking-widest text-gold-600">Extra gallery images</label>
        <input type="file" name="GalleryFiles" multiple
               accept="image/jpeg,image/png,image/webp,image/gif,.jpg,.jpeg,.png,.webp,.gif"
               class="block w-full cursor-pointer text-sm text-ink file:mr-4 file:cursor-pointer file:rounded-xl file:border file:border-gold-500/50 file:bg-gold-500/10 file:px-5 file:py-2.5 file:text-sm file:font-semibold file:text-gold-600" />
        @if (ViewContext.ModelState["GalleryFiles"]?.Errors is { Count: > 0 } galleryErrors)
        {
            <span class="mt-1 block text-xs text-red-700">@galleryErrors[0].ErrorMessage</span>
        }
        <p class="mt-1 text-xs text-ink/45">Optional — carousel on the product page only (not the shop listing). Up to @FantasyBooks.Services.ProductImageBlobStore.MaxGalleryImagesPerProduct images, 2&nbsp;MB each.</p>
    </div>
    <div>
        <label asp-for="Description" class="mb-2 block text-xs font-semibold uppercase tracking-widest text-gold-600"></label>
        <textarea asp-for="Description" id="Input_Description" rows="3" class="sr-only" tabindex="-1" aria-hidden="true"></textarea>
        <div class="description-quill-wrap overflow-hidden rounded-xl border border-ink/15 bg-white/60">
            <div id="description-editor" class="min-h-[12rem] text-sm text-ink"></div>
        </div>
        <span asp-validation-for="Description" class="mt-1 block text-xs text-red-700"></span>
        <p class="mt-1 text-xs text-ink/45">Use the toolbar to format. No HTML knowledge needed.</p>
    </div>
    <div id="product-options" data-max-groups="@FantasyBooks.Services.ProductOptionsFormat.MaxGroups" data-max-choices="@FantasyBooks.Services.ProductOptionsFormat.MaxChoicesPerGroup">
        <label class="mb-2 block text-xs font-semibold uppercase tracking-widest text-gold-600">Product options</label>
        <p class="mb-3 text-xs text-ink/45">Optional — e.g. Colour or Style. Shoppers must pick one choice per group on the product page. Leave empty if this product has no options.</p>
        @if (ViewContext.ModelState["OptionGroups"]?.Errors is { Count: > 0 } optionErrors)
        {
            <span class="mb-2 block text-xs text-red-700">@optionErrors[0].ErrorMessage</span>
        }
        <div id="option-groups" class="space-y-4">
            @{
                var optionGroups = ViewData["OptionGroups"] as IList<FantasyBooks.Services.ProductOptionStore.GroupInput>
                    ?? new List<FantasyBooks.Services.ProductOptionStore.GroupInput>();
                if (optionGroups.Count == 0)
                    optionGroups = new List<FantasyBooks.Services.ProductOptionStore.GroupInput>();
            }
            @for (var gi = 0; gi < optionGroups.Count; gi++)
            {
                var g = optionGroups[gi];
                var choices = g.Choices ?? [];
                <div class="option-group rounded-xl border border-ink/10 bg-white/40 p-4" data-option-group>
                    <div class="flex flex-wrap items-end gap-3">
                        <div class="min-w-[10rem] flex-1">
                            <label class="mb-1 block text-[10px] font-semibold uppercase tracking-wider text-ink/45">Group name</label>
                            <input type="text" name="OptionGroups[@gi].Name" value="@g.Name" maxlength="80" placeholder="e.g. Colour"
                                   class="w-full rounded-lg border border-ink/15 bg-white/70 px-3 py-2 text-sm text-ink outline-none focus:ring-2 focus:ring-gold-500/30" />
                        </div>
                        <button type="button" class="option-group-remove text-xs font-semibold text-ink/50 transition hover:text-red-700" data-remove-group>Remove group</button>
                    </div>
                    <div class="mt-3 space-y-2" data-choices>
                        @for (var ci = 0; ci < Math.Max(choices.Count, 1); ci++)
                        {
                            var label = ci < choices.Count ? choices[ci] : "";
                            <div class="flex items-center gap-2" data-choice-row>
                                <input type="text" name="OptionGroups[@gi].Choices[@ci]" value="@label" maxlength="80" placeholder="e.g. Red"
                                       class="w-full rounded-lg border border-ink/15 bg-white/70 px-3 py-2 text-sm text-ink outline-none focus:ring-2 focus:ring-gold-500/30" />
                                <button type="button" class="shrink-0 text-xs font-semibold text-ink/45 hover:text-red-700" data-remove-choice aria-label="Remove choice">×</button>
                            </div>
                        }
                    </div>
                    <button type="button" class="mt-2 text-xs font-semibold text-gold-600 hover:text-gold-500" data-add-choice>+ Add choice</button>
                </div>
            }
        </div>
        <button type="button" id="add-option-group" class="mt-3 text-sm font-semibold text-gold-600 transition hover:text-gold-500">+ Add option group</button>
    </div>
    <div>
        <label asp-for="TikTokId" class="mb-2 block text-xs font-semibold uppercase tracking-widest text-gold-600"></label>
        <input asp-for="TikTokId"
               class="w-full rounded-xl border border-ink/15 bg-white/60 px-4 py-3 text-sm text-ink outline-none focus:ring-2 focus:ring-gold-500/30" />
        <span asp-validation-for="TikTokId" class="mt-1 block text-xs text-red-700"></span>
        <p class="mt-1 text-xs text-ink/45">Optional — used when syncing with TikTok imports.</p>
    </div>
    <div>
        <label asp-for="TikTokVideoUrl" class="mb-2 block text-xs font-semibold uppercase tracking-widest text-gold-600"></label>
        <input asp-for="TikTokVideoUrl" placeholder="https://www.tiktok.com/@@account/video/…"
               class="w-full rounded-xl border border-ink/15 bg-white/60 px-4 py-3 text-sm text-ink outline-none focus:ring-2 focus:ring-gold-500/30" />
        <span asp-validation-for="TikTokVideoUrl" class="mt-1 block text-xs text-red-700"></span>
        <p class="mt-1 text-xs text-ink/45">Optional — when set, an embed appears on this product’s shop page. Leave blank if there isn’t one.</p>
    </div>
    <div class="flex flex-wrap items-center gap-4 pt-2">
        <button type="submit" class="magical-glow-btn rounded-xl bg-gold-500 px-7 py-3 text-sm font-semibold text-ink shadow-md transition hover:bg-gold-600">
            Save product
        </button>
        <a asp-page="./Index" class="text-sm font-semibold text-ink/70 transition hover:text-gold-600">Cancel</a>
    </div>
</form>
