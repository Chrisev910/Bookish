@model FantasyBooks.Pages.Admin.Products.CreateModel.ProductInput

<form method="post" class="space-y-5 rounded-2xl border border-ink/10 bg-white/35 p-6 shadow-float backdrop-blur-[10px] sm:p-8">
    @if (ViewData["EditProductId"] is int editId)
    {
        <input type="hidden" name="Id" value="@editId" />
    }
    <div>
        <label asp-for="Name" class="mb-2 block text-xs font-semibold uppercase tracking-widest text-gold-600"></label>
        <input asp-for="Name" class="w-full rounded-xl border border-ink/15 bg-white/60 px-4 py-3 text-sm text-ink outline-none focus:ring-2 focus:ring-gold-500/30" />
        <span asp-validation-for="Name" class="mt-1 block text-xs text-red-700"></span>
    </div>
    <div>
        <label asp-for="Price" class="mb-2 block text-xs font-semibold uppercase tracking-widest text-gold-600"></label>
        <input asp-for="Price" type="number" step="0.01" min="0.01"
               class="w-full rounded-xl border border-ink/15 bg-white/60 px-4 py-3 text-sm text-ink outline-none focus:ring-2 focus:ring-gold-500/30" />
        <span asp-validation-for="Price" class="mt-1 block text-xs text-red-700"></span>
    </div>
    <div>
        <label asp-for="ImageUrl" class="mb-2 block text-xs font-semibold uppercase tracking-widest text-gold-600"></label>
        <input asp-for="ImageUrl" placeholder="https://…"
               class="w-full rounded-xl border border-ink/15 bg-white/60 px-4 py-3 text-sm text-ink outline-none focus:ring-2 focus:ring-gold-500/30" />
        <span asp-validation-for="ImageUrl" class="mt-1 block text-xs text-red-700"></span>
        <p class="mt-1 text-xs text-ink/45">Paste a direct link to an image (HTTPS). Leave blank for no cover.</p>
        @if (!string.IsNullOrWhiteSpace(Model?.ImageUrl))
        {
            <img src="@Model.ImageUrl" alt="" class="mt-3 max-h-40 rounded-xl object-cover ring-1 ring-ink/10" />
        }
    </div>
    <div>
        <label asp-for="Description" class="mb-2 block text-xs font-semibold uppercase tracking-widest text-gold-600"></label>
        <textarea asp-for="Description" rows="5"
                  class="w-full rounded-xl border border-ink/15 bg-white/60 px-4 py-3 text-sm text-ink outline-none focus:ring-2 focus:ring-gold-500/30"></textarea>
        <span asp-validation-for="Description" class="mt-1 block text-xs text-red-700"></span>
    </div>
    <div>
        <label asp-for="TikTokId" class="mb-2 block text-xs font-semibold uppercase tracking-widest text-gold-600"></label>
        <input asp-for="TikTokId"
               class="w-full rounded-xl border border-ink/15 bg-white/60 px-4 py-3 text-sm text-ink outline-none focus:ring-2 focus:ring-gold-500/30" />
        <span asp-validation-for="TikTokId" class="mt-1 block text-xs text-red-700"></span>
        <p class="mt-1 text-xs text-ink/45">Optional — used when syncing with TikTok imports.</p>
    </div>
    <div class="flex flex-wrap items-center gap-4 pt-2">
        <button type="submit" class="magical-glow-btn rounded-xl bg-gold-500 px-7 py-3 text-sm font-semibold text-ink shadow-md transition hover:bg-gold-600">
            Save product
        </button>
        <a asp-page="./Index" class="text-sm font-semibold text-ink/70 transition hover:text-gold-600">Cancel</a>
    </div>
</form>
