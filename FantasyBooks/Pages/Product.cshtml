@page "/Product/{id:int}"
@model ProductModel
@{
    var p = Model.ProductDetail!;
    ViewData["Title"] = p.Name;
    var slides = Model.GallerySrcs;
    var multi = slides.Count > 1;
}

<div class="mx-auto max-w-3xl">
    <p class="mb-6">
        <a asp-page="/Catalog" class="text-sm font-semibold text-ink/70 underline decoration-gold-500/45 underline-offset-2 transition hover:text-gold-600">← Back to the collection</a>
    </p>

    <article class="overflow-hidden rounded-2xl border border-ink/12 bg-white/35 shadow-float backdrop-blur-[12px]">
        <div class="relative aspect-[4/3] max-h-[min(52vh,28rem)] w-full overflow-hidden bg-gradient-to-br from-ink/5 to-gold-500/5 sm:aspect-[16/10]">
            @if (slides.Count > 0)
            {
                <div class="product-gallery@(multi ? " product-gallery--multi" : "")"
                     data-product-gallery
                     @(multi ? "tabindex=\"0\"" : null)
                     role="@(multi ? "region" : null)"
                     aria-roledescription="@(multi ? "carousel" : null)"
                     aria-label="@(multi ? "Product photos" : null)">
                    <div class="product-gallery__track" data-gallery-track>
                        @for (var i = 0; i < slides.Count; i++)
                        {
                            <div class="product-gallery__slide@(i == 0 ? " is-active" : "")"
                                 data-gallery-slide
                                 @(multi ? $"aria-hidden=\"{(i == 0 ? "false" : "true")}\"" : null)>
                                <img src="@slides[i]" alt="@(i == 0 ? p.Name : $"{p.Name} — photo {i + 1}")"
                                     class="product-gallery__img"
                                     @(i == 0 ? null : "loading=\"lazy\"") />
                            </div>
                        }
                    </div>
                    @if (multi)
                    {
                        <button type="button" class="product-gallery__nav product-gallery__nav--prev" data-gallery-prev aria-label="Previous photo">
                            <span aria-hidden="true">‹</span>
                        </button>
                        <button type="button" class="product-gallery__nav product-gallery__nav--next" data-gallery-next aria-label="Next photo">
                            <span aria-hidden="true">›</span>
                        </button>
                        <div class="product-gallery__dots" data-gallery-dots role="tablist" aria-label="Choose photo">
                            @for (var i = 0; i < slides.Count; i++)
                            {
                                <button type="button"
                                        class="product-gallery__dot@(i == 0 ? " is-active" : "")"
                                        data-gallery-dot="@i"
                                        role="tab"
                                        aria-selected="@(i == 0 ? "true" : "false")"
                                        aria-label="Photo @(i + 1)"></button>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="flex h-full min-h-[14rem] items-center justify-center text-6xl text-ink/15" aria-hidden="true">✦</div>
            }
        </div>
        <div class="space-y-5 p-6 sm:p-8">
            <header class="space-y-2">
                <h1 class="font-display text-3xl font-semibold leading-tight text-ink sm:text-4xl">@p.Name</h1>
                <p class="font-display text-3xl font-semibold tabular-nums text-ink">@p.Price.ToString("C")</p>
            </header>
            @if (!string.IsNullOrWhiteSpace(p.Description))
            {
                var safeHtml = DescriptionHtml.Sanitize(p.Description);
                if (!string.IsNullOrWhiteSpace(safeHtml))
                {
                    <div class="product-description border-t border-ink/10 pt-5 text-base leading-relaxed text-ink/70">
                        @Html.Raw(safeHtml)
                    </div>
                }
            }

            @if (!string.IsNullOrWhiteSpace(Model.TikTokEmbedHtml))
            {
                <section class="border-t border-ink/10 pt-6" aria-label="Related TikTok">
                    <p class="text-xs font-semibold uppercase tracking-[0.28em] text-gold-600">See it in motion</p>
                    <h2 class="mt-1 font-display text-xl font-semibold text-ink">On TikTok</h2>
                    <div class="product-tiktok-embed mt-4 overflow-hidden rounded-2xl border border-ink/10 bg-white/50 shadow-inner">
                        <div class="tiktok-embed-host mx-auto max-w-sm">
                            @Html.Raw(Model.TikTokEmbedHtml)
                        </div>
                    </div>
                </section>
            }

            <div class="border-t border-ink/10 pt-6">
                <form method="post" asp-page="/Product" asp-route-id="@p.Id" asp-page-handler="AddToCart" class="flex flex-wrap items-center gap-4">
                    <input type="hidden" name="productId" value="@p.Id" />
                    <button type="submit" class="magical-glow-btn rounded-xl bg-gold-500 px-8 py-3.5 text-sm font-semibold text-ink shadow-md transition hover:bg-gold-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-gold-500/50 focus-visible:ring-offset-2 focus-visible:ring-offset-paper">
                        Add to Satchel
                    </button>
                    <a asp-page="/Cart" class="text-sm font-semibold text-ink/70 hover:text-gold-600">View satchel</a>
                </form>
            </div>
        </div>
    </article>
</div>
